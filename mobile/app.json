{
  "expo": {
    "name": "Skill Exchange",
    "slug": "student-skill-exchange",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "skillexchange",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#5B4BE8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.akshitkumar.skillexchange",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Your location is used to find students nearby who can teach you in person.",
        "NSPhotoLibraryUsageDescription": "Choose a photo for your profile or to share in a chat."
      }
    },
    "android": {
      "package": "com.akshitkumar.skillexchange",
      "adaptiveIcon": {
        "backgroundColor": "#5B4BE8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      "expo-location",
      [
        "expo-image-picker",
        {
          "microphonePermission": false,
          "cameraPermission": false
        }
      ],
      "expo-web-browser",
      "expo-font"
    ],
    "extra": {
      "apiUrl": "http://localhost:4000",
      "google": {
        "expo": "",
        "ios": "",
        "android": "",
        "web": ""
      },
      "eas": {
        "projectId": "0aebca0f-a2f6-4167-b63f-58207d32a9b0"
      }
    },
    "owner": "akshit-afk-dot0102"
  }
}
