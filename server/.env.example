# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_NAME=Student Skill Exchange
# Public base URL of this API. Used to build links in emails and local upload URLs.
PUBLIC_URL=http://localhost:4000

# ─── Database ────────────────────────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/student-skill-exchange
# Atlas:  mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/student-skill-exchange
MONGO_URI=mongodb://127.0.0.1:27017/student-skill-exchange

# ─── Auth ────────────────────────────────────────────────────────────────────
# REQUIRED in production: 32+ chars each, and they must differ.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated browser origins for the admin dashboard.
# Empty means "allow anything" in development; it is REQUIRED in production.
# Note localhost and 127.0.0.1 are different origins — list both if you use both.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Matching weights ────────────────────────────────────────────────────────
# Must sum to exactly 1.0 or the server refuses to start.
MATCH_W_SKILL=0.40
MATCH_W_AVAILABILITY=0.20
MATCH_W_EXPERIENCE=0.15
MATCH_W_RATING=0.15
MATCH_W_LOCATION=0.10
# Multiplier applied to skill compatibility when the exchange runs both ways.
MATCH_EXCHANGE_BONUS=1.25
# Distance at which the location score decays to its floor.
MATCH_MAX_DISTANCE_KM=50

# ─── Bootstrap admin ─────────────────────────────────────────────────────────
# Created on first boot only, and only if no admin exists yet.
ADMIN_EMAIL=admin@yourcollege.edu
ADMIN_PASSWORD=change-this-password

# ─── Optional: file storage ──────────────────────────────────────────────────
# Without these, uploads are written to ./uploads and served by the API.
# That does NOT survive an ephemeral filesystem (Render, Heroku, Cloud Run) —
# configure Cloudinary for any such deployment.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# ─── Optional: push notifications (Firebase Cloud Messaging) ─────────────────
# Without these, push is disabled. In-app and realtime notifications still work.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key on one line with literal \n where the newlines were.
FIREBASE_PRIVATE_KEY=

# ─── Optional: Google sign-in ────────────────────────────────────────────────
# Comma-separated OAuth client IDs (web, iOS, Android) allowed as token audiences.
GOOGLE_CLIENT_IDS=

# ─── Optional: email (SMTP) ──────────────────────────────────────────────────
# Without these, verification links and reset codes are written to the server log
# instead of being sent — which is enough to test the flows end to end.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=Student Skill Exchange <no-reply@example.com>

# ─── Misc ────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
ENABLE_JOBS=true
